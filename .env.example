# 이 파일을 .env 로 복사해서 값을 채우세요. (.env 는 git 등에 올리지 마세요)
SEC_USER_AGENT="Hong Gildong hong@example.com"
# 텔레그램 알림(선택)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# 토스증권 Open API (선택) — 발급: 토스증권 WTS > 설정 > Open API. 허용 IP 등록 필수.
# 이 값은 계좌 접근 권한과 연결될 수 있으니 절대 공유하지 마세요.
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=

# 🤖 AI 요약 · 🔀 교차검증 (Anthropic API, claude.ai 구독과 별도 결제 — console.anthropic.com 에서 키 발급)
ANTHROPIC_API_KEY=
